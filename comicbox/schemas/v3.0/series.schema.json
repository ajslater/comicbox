{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ajslater/comicbox/blob/main/schemas/v3.0/series.schema.json",
  "title": "Comicbox Series",
  "type": "object",
  "properties": {
    "alternative_names": {
      "type": "array",
      "items": {
        "$ref": "alternative-name.schema.json"
      }
    },
    "end_year": {
      "type": "integer"
    },
    "identifiers": {
      "$ref": "identifiers.schema.json"
    },
    "name": {
      "type": "string"
    },
    "sort_name": {
      "type": "string"
    },
    "start_year": {
      "type": "integer"
    },
    "status": {
      "type": "string",
      "enum": ["Ongoing", "Cancelled", "Completed", "Hiatus"]
    },
    "summary": {
      "type": "string"
    },
    "volume_count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
