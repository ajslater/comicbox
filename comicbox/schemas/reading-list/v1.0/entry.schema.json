{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ajslater/comicbox/blob/main/schemas/reading-list/v1.0/entry.schema.json",
  "title": "Comicbox Reading List Entry",
  "description": "One issue in a reading list, in comicbox's own vocabulary.",
  "type": "object",
  "properties": {
    "series": {
      "$ref": "../../v3.0/series.schema.json"
    },
    "volume": {
      "$ref": "../../v3.0/volume.schema.json"
    },
    "issue": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "number": {
          "type": "number"
        },
        "suffix": {
          "type": "string"
        }
      }
    },
    "date": {
      "$ref": "../../v3.0/date.schema.json"
    },
    "identifiers": {
      "$ref": "../../v3.0/identifiers.schema.json"
    },
    "entry_type": {
      "description": "A free string, lowercased: prologue, core, tie-in, epilogue, or another.",
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  }
}
